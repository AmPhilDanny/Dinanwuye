# Render Static Site redirect rules
# IMPORTANT: In Render, 200 rewrite rules override even existing files.
# ALL static asset paths must be explicitly excluded before the SPA catch-all.

# Static assets with content hashes (Vite output) — serve as-is
/assets/*             /assets/:splat        200

# Service worker & PWA files — must be served as JS, not rewritten to HTML
/sw.js                /sw.js                200
/registerSW.js        /registerSW.js        200
/workbox-*.js         /workbox-:splat        200
/manifest.webmanifest /manifest.webmanifest 200

# Other root-level static files
/favicon.svg          /favicon.svg          200
/apple-touch-icon.png /apple-touch-icon.png 200

# SPA catch-all — all remaining paths serve the React app shell
/*                    /index.html           200
