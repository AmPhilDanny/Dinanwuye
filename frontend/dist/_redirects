# Render Static Site redirect rules
# IMPORTANT: Specific file rules must come BEFORE the SPA catch-all

# Do NOT rewrite service worker or workbox files — they must be served as-is
/sw.js                /sw.js                200
/registerSW.js        /registerSW.js        200
/workbox-*.js         /workbox-:splat.js    200
/manifest.webmanifest /manifest.webmanifest 200

# SPA catch-all — everything else routes to index.html
/*                    /index.html           200
