{
  "name": "dinanwuye-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Dinanwuye Backend — Consolidated NestJS API + Python/FastAPI Matching",
  "workspaces": [
    "consolidated-app"
  ],
  "scripts": {
    "build": "pnpm --filter @dinanwuye/api build",
    "start": "pnpm --filter @dinanwuye/api start",
    "start:dev": "pnpm --filter @dinanwuye/api start:dev",
    "test": "pnpm --filter @dinanwuye/api test",
    "db:migrate": "pnpm --filter @dinanwuye/api db:migrate",
    "db:seed": "pnpm --filter @dinanwuye/api db:seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
