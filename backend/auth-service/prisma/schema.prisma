// Dinanwuye Auth & Identity Service — Prisma schema
// Database: PostgreSQL (shared `dinanwuye` database, per-service table namespaces)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  emailHash    String?  // privacy: store hash for lookups
  phoneHash    String?
  passwordHash String?
  status       String   @default("active") // active | suspended | banned | deleted
  role         String   @default("user")
  isVerified   Boolean  @default(false) // selfie/liveness verified
  deviceFingerprint String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  @@index([email])
  @@index([phone])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  deviceInfo String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpCode {
  id         String   @id @default(uuid())
  userId     String? // null when OTP is issued before an account exists (pre-signup phone verify)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier String // email or phone the OTP was sent to
  codeHash   String // bcrypt hash of the OTP
  purpose    String   @default("signup") // signup | login | password_reset
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, purpose])
  @@index([identifier])
}