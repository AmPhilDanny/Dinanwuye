// Dinanwuye Consolidated API — Prisma schema
// Database: PostgreSQL with pgvector
// Consolidates: auth, profile, messaging, admin, trust-safety services

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["dinanwuye_auth", "dinanwuye_profile", "dinanwuye_messaging", "dinanwuye_matching", "dinanwuye_trust_safety", "dinanwuye_admin", "dinanwuye_notification", "dinanwuye_payment"]
}

// ============================================================
// AUTH & IDENTITY (from auth-service)
// ============================================================

model User {
  id                String   @id @default(uuid())
  email             String?  @unique
  phone             String?  @unique
  emailHash         String?  // privacy: store hash for lookups
  phoneHash         String?
  passwordHash      String?
  status            String   @default("active") // active | suspended | banned | deleted
  role              String   @default("user")
  isVerified        Boolean  @default(false) // selfie/liveness verified
  deviceFingerprint String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  refreshTokens     RefreshToken[]
  otpCodes          OtpCode[]
  profile           Profile?
  conversationsA    Conversation[] @relation("ConversationUserA")
  conversationsB    Conversation[] @relation("ConversationUserB")
  messages          Message[]
  blocksBlocked     Block[] @relation("BlockBlocker")
  blocksBlocker     Block[] @relation("BlockBlocked")
  reportsReported   Report[] @relation("ReportReporter")
  reportsTarget     Report[] @relation("ReportTarget")
  ban               Ban?
  swipeActor        Swipe[] @relation("SwipeActor")
  swipeTarget       Swipe[] @relation("SwipeTarget")
  matchesA          Match[] @relation("MatchUserA")
  matchesB          Match[] @relation("MatchUserB")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@schema("dinanwuye_auth")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti        String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceInfo String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@schema("dinanwuye_auth")
}

model OtpCode {
  id         String    @id @default(uuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier String    // email or phone the OTP was sent to
  codeHash   String    // bcrypt hash of the OTP
  purpose    String    @default("signup") // signup | login | password_reset
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([identifier])
  @@schema("dinanwuye_auth")
}

// ============================================================
// PROFILE (from profile-service)
// ============================================================

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  dob                DateTime
  gender             String   // male | female | non_binary
  seeking            String[] // genders interested in
  bio                String?
  heightCm           Int?
  ethnicity          String?
  religion           String?
  relationshipIntent String?
  education          String?
  occupation         String?
  languages          String[]
  interests          String[] // for matching heuristic (Jaccard overlap)
  locationLat        Float?
  locationLng        Float?
  locationName       String?
  isVerified         Boolean  @default(false)
  isActive           Boolean  @default(true)
  isPremium          Boolean  @default(false)
  lastActiveAt       DateTime @default(now())
  onboardingStep     Int      @default(0) // 0..N, resume point
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  photos      Photo[]
  preferences Preference?

  @@index([gender, seeking])
  @@index([isVerified])
  @@schema("dinanwuye_profile")
}

model Photo {
  id               String   @id @default(uuid())
  profileId        String
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  s3Key            String
  order            Int      @default(0)
  moderationStatus String   @default("pending") // pending | approved | rejected | in_review
  createdAt        DateTime @default(now())

  @@index([profileId])
  @@schema("dinanwuye_profile")
}

model Preference {
  id               String   @id @default(uuid())
  profileId        String   @unique
  profile          Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ageMin           Int      @default(21)
  ageMax           Int      @default(45)
  distanceKm       Int      @default(50)
  filtersJson      Json?
  showOnlineStatus Boolean  @default(true)
  showDistance      Boolean  @default(true)
  incognitoMode    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@schema("dinanwuye_profile")
}

// ============================================================
// MESSAGING (from messaging-service)
// ============================================================

model Conversation {
  id        String   @id @default(uuid())
  matchId   String?  // FK to Match.id
  userAId   String
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status    String   @default("active") // active | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userAId])
  @@index([userBId])
  @@unique([userAId, userBId])
  @@schema("dinanwuye_messaging")
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  contentEncrypted String
  contentType      String       @default("text") // text | image
  mediaRef         String?      // S3 key for image messages
  readAt           DateTime?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@schema("dinanwuye_messaging")
}

// ============================================================
// MATCHING (from matching-service - stored in DB)
// ============================================================

model Match {
  id        String   @id @default(uuid())
  userAId   String
  userA     User     @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status    String   @default("active") // active | unmatched
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@map("matches")
  @@schema("dinanwuye_matching")
}

model Swipe {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("SwipeActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User     @relation("SwipeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  action    String   // like | pass | superlike
  createdAt DateTime @default(now())

  @@unique([actorId, targetId])
  @@map("swipes")
  @@schema("dinanwuye_matching")
}

// ============================================================
// TRUST & SAFETY (from trust-safety-service)
// ============================================================

model Block {
  id         String   @id @default(uuid())
  blockerId  String
  blocker    User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId  String
  blocked    User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@schema("dinanwuye_trust_safety")
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String
  target     User     @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  category   String   // harassment | fake_profile | inappropriate_content | underage | scam | other
  details    String?
  contextRef String?  // e.g. conversation/message id
  status     String   @default("pending") // pending | reviewing | resolved | dismissed
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([targetId, status])
  @@index([reporterId])
  @@schema("dinanwuye_trust_safety")
}

model Ban {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  bannedBy  String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  liftedAt  DateTime?

  @@index([userId])
  @@schema("dinanwuye_trust_safety")
}

// ============================================================
// ADMIN (from admin-service)
// ============================================================

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // super_admin | admin | moderator
  permissions  String[] @default([])      // granular permissions
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs  AuditLog[]
  sessions   AdminSession[]

  @@index([email])
  @@index([role])
  @@schema("dinanwuye_admin")
}

model AuditLog {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String    // create | read | update | delete | bulk_update | bulk_delete
  entity    String    // User | Profile | Photo | Match | Swipe | AdminUser | etc.
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@schema("dinanwuye_admin")
}

model AdminSession {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@index([token])
  @@schema("dinanwuye_admin")
}

model AdminActivity {
  id        String   @id @default(uuid())
  adminId   String
  date      DateTime @db.Date
  actions   Json     // { create: 5, read: 10, update: 3, delete: 1 }
  createdAt DateTime @default(now())

  @@unique([adminId, date])
  @@index([date])
  @@schema("dinanwuye_admin")
}

// ============================================================
// NOTIFICATION (from notification-service)
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // push | email | sms
  title     String
  body      String
  data      Json?
  sentAt    DateTime @default(now())
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sentAt])
  @@schema("dinanwuye_notification")
}

model PushSubscription {
  id           String   @id @default(uuid())
  userId       String
  endpoint     String
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
  @@unique([endpoint])
  @@schema("dinanwuye_notification")
}

// ============================================================
// PAYMENT (from payment-service)
// ============================================================

model Subscription {
  id              String    @id @default(uuid())
  userId          String    @unique
  provider        String    // stripe | paystack
  providerId      String    // subscription ID from provider
  planId          String    // premium_monthly | premium_annual | premium_lifetime
  status          String    @default("active") // active | canceled | past_due | trialing
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt        DateTime?
  canceledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([providerId])
  @@schema("dinanwuye_payment")
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  provider      String   // stripe | paystack
  providerId    String   // payment/intent ID
  amount        Int      // amount in smallest currency unit
  currency      String   @default("NGN")
  status        String   @default("pending") // pending | succeeded | failed | refunded
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([providerId])
  @@index([status])
  @@schema("dinanwuye_payment")
}
