# ============================================================
# Dinanwuye — Consolidated Backend API Environment Variables
# Copy to .env and fill in REAL secrets. NEVER commit .env.
# ============================================================

# ---------- App ----------
NODE_ENV=production
PORT=3000

# ---------- Postgres (pgvector) - Supabase ----------
DATABASE_URL=postgresql://postgres:dinanwuye%402026@db.ysvqvrskwyyjbeepbyuc.supabase.co:5432/postgres

# ---------- Supabase Storage ----------
SUPABASE_URL=https://ysvqvrskwyyjbeepbyuc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_from_supabase_dashboard

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- JWT / Auth ----------
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=CHANGE_ME

# ---------- CORS ----------
CORS_ORIGIN=https://dinanwuye.onrender.com,https://dinanwuye-admin.onrender.com

# ---------- SMTP (Notification) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="Dinanwuye <no-reply@dinanwuye.com>"

# ---------- Web Push VAPID (Notification) ----------
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@dinanwuye.com

# ---------- Payments ----------
# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=xxx

# ---------- Trust & Safety ----------
MODERATION_IMAGE_API_KEY=CHANGE_ME
MODERATION_TEXT_API_KEY=CHANGE_ME
IDENTITY_VERIFICATION_API_KEY=CHANGE_ME

# ---------- Matching Service (Internal) ----------
PROFILE_SERVICE_URL=https://dinanwuye-api.onrender.com
MESSAGING_SERVICE_URL=https://dinanwuye-api.onrender.com
