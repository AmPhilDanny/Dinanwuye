# ============================================================
# Dinanwuye — Backend Environment Variables (.env.example)
# Copy to .env and fill in REAL secrets. NEVER commit .env.
# Reference: docker-compose.yml, deployment/vps-provisioning.md
# ============================================================

# ---------- App ----------
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

# ---------- Postgres (pgvector) ----------
# Used by NestJS services (Prisma)
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/dinanwuye
# Used by matching-service (SQLAlchemy async)
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/dinanwuye

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- Photo storage ----------
# V0 stores validated image data URLs in the Profile Photo table.
# Object storage variables are intentionally omitted until a provider is available.

# ---------- JWT / Auth ----------
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=CHANGE_ME                  # OTP signing secret (email/phone OTP)

# ---------- SMTP (notification-service) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="Dinanwuye <no-reply@dinanwuye.com>"

# ---------- Web Push (VAPID) ----------
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@dinanwuye.com

# ---------- Payments ----------
# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=xxx

# ---------- CORS ----------
# Comma-separated allowed origins for the API
CORS_ORIGIN=https://dinanwuye.com,https://www.dinanwuye.com

# ---------- Matching Service ----------
# Internal service URLs (docker network)
PROFILE_SERVICE_URL=http://profile-service:3002
MESSAGING_SERVICE_URL=http://messaging-service:3003

# ---------- Trust & Safety ----------
# Moderation APIs (image + text) — vendor keys
MODERATION_IMAGE_API_KEY=CHANGE_ME
MODERATION_TEXT_API_KEY=CHANGE_ME
IDENTITY_VERIFICATION_API_KEY=CHANGE_ME

# ---------- Ports (internal, docker network) ----------
PORT=3000          # api-gateway
AUTH_SERVICE_PORT=3001
PROFILE_SERVICE_PORT=3002
MESSAGING_SERVICE_PORT=3003
WS_PORT=3004
TRUST_SAFETY_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007
MATCHING_SERVICE_PORT=8000