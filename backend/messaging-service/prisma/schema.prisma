// Dinanwuye Messaging Service — Prisma schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id         String   @id @default(uuid())
  matchId    String?  // FK to matching-service Match.id (cross-service by convention)
  userAId    String
  userBId    String
  status     String   @default("active") // active | closed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]
  @@index([userAId])
  @@index([userBId])
  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  contentEncrypted String
  contentType    String       @default("text") // text | image
  mediaRef       String?      // S3 key for image messages
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}