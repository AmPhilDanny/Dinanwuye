# Admin Service Environment Variables
# Copy to .env and fill in REAL secrets. NEVER commit .env.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dinanwuye

# JWT (must match other services)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# CORS - comma-separated origins (for local dev: add your frontend URLs)
CORS_ORIGIN=http://localhost:5174,http://localhost:5173,https://dinanwuye-frontend.onrender.com,https://dinanwuye-admin.onrender.com

# App
NODE_ENV=development
PORT=3007